# FORMA³ backend — переменные окружения.
# Скопируйте в .env (или экспортируйте в окружение) и заполните секреты.
# Все значения ниже — дев-дефолты/примеры; реальные секреты сюда не коммитить.

# Режим работы: dev | production.
# В production сервер ОТКАЗЫВАЕТСЯ стартовать, если: JWT_SECRET пуст/короче
# 32 байт, ADMIN_PASSWORD_HASH пуст, FRONTEND_URL или CORS_ORIGINS содержат
# localhost. В dev — предупреждения и дев-фолбэки.
APP_ENV=dev

# Порт HTTP-сервера (сервер слушает :<PORT>).
PORT=8090

# Путь к файлу SQLite; директория создаётся автоматически.
DB_PATH=./data/forma3d.db

# CSV-allowlist источников для CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Доверять заголовку X-Forwarded-For (true/false, дефолт false).
# Включать ТОЛЬКО если сервер стоит за доверенным обратным прокси
# (Fly.io, Railway, nginx): клиентский IP для rate limit берётся из
# первого адреса X-Forwarded-For, иначе — из соединения (RemoteAddr).
TRUSTED_PROXY=false

# Секрет подписи JWT (HS256), минимум 32 байта.
# Пусто в деве = случайный секрет на каждый старт (токены слетают при рестарте).
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Email администратора.
ADMIN_EMAIL=admin@forma3d.studio

# bcrypt-хеш пароля администратора.
# ПРИМЕР НИЖЕ — хеш пароля 'admin', только для локальной разработки!
# Сгенерировать свой: htpasswd -bnBC 10 "" '<пароль>' | tr -d ':\n'
ADMIN_PASSWORD_HASH=$2a$10$p6iCCN2Fkz49gr7LOoB9muaL4ksqaVgcqOLMGu6EdvMOpTghPuGna

# Ключ Stripe (sk_test_… / sk_live_…). Пусто = mock-режим оплаты без payUrl.
STRIPE_SECRET_KEY=

# Секрет подписи Stripe-webhook (whsec_…); обязателен для /stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Валюта Stripe Checkout: usd | eur | rub (дефолт usd).
STRIPE_CURRENCY=usd

# Курс конвертации для usd/eur: рублей за единицу валюты (дефолт 90).
# Цены в БД хранятся в рублях; сумма списания = round(цена / курс × 100)
# в минорных единицах валюты (центах). Для rub не используется.
PRICE_FX_RATE=90

# База фронтенда для success/cancel-URL Stripe Checkout.
FRONTEND_URL=http://localhost:5173

# Telegram-уведомления о новых заказах (opt-in): работают, только если
# заданы ОБА значения; иначе уведомления выключены.
# Токен бота — от @BotFather; chat id — id личного чата/группы/канала.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
